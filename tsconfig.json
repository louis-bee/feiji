{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.vue",
    "shared/**/*.ts",
    "server/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}